# LangSmith (observabilidad del agente; opcional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio-agent

# SQLite Database
SQLITE_DB_PATH=./data/portfolio.db

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string

# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_TRANSLATOR_MODEL=openai/gpt-oss-120b
OPENROUTER_CLASSIFIER_MODEL=openai/gpt-oss-120b

# Mailing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=app-password
JONATHAN_EMAIL=jonathan@email.com
PABLO_EMAIL=pablo@email.com

# Cors
CORS_ORIGINS=["http://localhost:4321"]

# App Internal Config
CHAT_DAILY_LIMIT=10
EMAIL_DAILY_LIMIT=2

# Logs
LOG_FILE_PATH=./logs/app.log

# Vector Database
WEAVIATE_URL="url"
WEAVIATE_API_KEY="API Key"
